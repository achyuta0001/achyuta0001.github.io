---
import type { CollectionEntry } from 'astro:content';
import { postDate } from '../data/writing';
interface Props { posts: CollectionEntry<'writing'>[] }
const { posts } = Astro.props;
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <a class="post-title" href={`/writing/${p.id}/`}>{p.data.title}</a>
      <p class="muted post-desc">{p.data.description}</p>
      <time class="mono muted post-date" datetime={p.data.date.toISOString().slice(0, 10)}>{postDate(p.data.date)}</time>
    </li>
  ))}
</ul>
<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .post-title { font-weight: 600; text-decoration: none; }
  .post-desc { margin: 0.25rem 0; font-size: 0.9375rem; }
  .post-date { font-size: 0.75rem; }
</style>
