---
import { Image } from 'astro:assets';
import { projects } from '../data/site';
import { activityFor, formatUpdated } from '../data/github';
import SecIndex from './SecIndex.astro';
const pad = (n: number) => String(n).padStart(2, '0');
// The first capture is high on the page; lazy-loading it would delay LCP on
// tall screens. The rest load on scroll.
const firstShot = projects.findIndex((p) => p.image);
const activity = await activityFor(projects.map((p) => p.href));
---
<section id="work" class="section" data-reveal tabindex="-1" aria-labelledby="work-h">
  <SecIndex id="work" />
  <h2 id="work-h" data-fx-label="h2 · work">Selected work</h2>
  <ol class="work-list">
    {projects.map((p, i) => (
      <li class:list={['work-row', { 'has-shot': p.image }]}>
        <span class="num mono">{pad(i + 1)}</span>
        <div class="work-body">
          <div class="work-text">
            <div class="work-head">
              <a class="work-title" href={p.href} target="_blank" rel="noopener">
                {p.title}<span class="arrow" aria-hidden="true">↗</span>
              </a>
              <span class="mono muted year">{p.year}</span>
            </div>
            <p class="pitch">{p.pitch}</p>
            <div class="meta">
              <ul class="tags mono" aria-label="Tags">
                {p.tags.map((t) => <li>{t}</li>)}
              </ul>
              {activity[i] && (
                <p class="activity mono muted">
                  <time datetime={activity[i].pushedAt.toISOString()}>{formatUpdated(activity[i].pushedAt)}</time>
                  {activity[i].stars > 0 && <span> · <span aria-hidden="true">★</span> {activity[i].stars}<span class="visually-hidden"> stars</span></span>}
                </p>
              )}
            </div>
            {p.extra.length > 0 && (
              <p class="extra">
                {p.extra.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
                ))}
              </p>
            )}
          </div>
          {p.image && (
            <Image
              class="shot"
              src={p.image.src}
              alt={p.image.alt}
              widths={[480, 720, 1080, 1440]}
              sizes="(min-width: 1200px) 640px, (min-width: 900px) 55vw, calc(100vw - 5rem)"
              loading={i === firstShot ? 'eager' : 'lazy'}
              decoding="async"
            />
          )}
        </div>
      </li>
    ))}
  </ol>
</section>
<style>
  .work-list { list-style: none; margin: 0; padding: 0; }
  .work-row {
    display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 0.5rem;
    padding-block: 1.75rem; border-top: 1px solid var(--line);
  }
  .num { font-size: 0.8125rem; color: var(--red); padding-top: 0.55rem; }
  .work-body { display: grid; gap: 1.5rem; min-width: 0; }
  .has-shot .work-body { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) {
    .has-shot .work-body { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; }
  }
  .work-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .work-title {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem); font-weight: 800; font-stretch: 72%; line-height: 1;
    text-decoration: none;
  }
  .arrow { display: inline-block; margin-left: 0.35rem; font-size: 0.6em; vertical-align: 0.35em; color: var(--muted); transition: transform 200ms ease, color 200ms ease; }
  .work-title:hover .arrow, .work-title:focus-visible .arrow { transform: translate(3px, -3px); color: var(--red); }
  .year { font-size: 0.8125rem; }
  .pitch { margin: 0.75rem 0 1rem; max-width: 60ch; color: var(--muted); }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.375rem; padding: 0; margin: 0; font-size: 0.75rem; }
  .tags li { border: 1px solid var(--line); padding: 0.1rem 0.5rem; color: var(--fg); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .activity { margin: 0; font-size: 0.75rem; }
  .extra { margin: 0.75rem 0 0; font-size: 0.875rem; }
  .shot { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
</style>
