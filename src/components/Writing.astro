---
import PostList from './PostList.astro';
import SecIndex from './SecIndex.astro';
import { getPosts } from '../data/writing';
const posts = await getPosts();
---
{posts.length > 0 && (
  <section id="writing" class="section" data-reveal tabindex="-1" aria-labelledby="writing-h">
    <SecIndex id="writing" />
    <h2 id="writing-h" data-fx-label="h2 · writing">Writing</h2>
    <PostList posts={posts} />
  </section>
)}
