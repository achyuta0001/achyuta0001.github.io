---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Experience from '../components/Experience.astro';
import Stack from '../components/Stack.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { profile, links, meta, employer } from '../data/site';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: meta.url,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: profile.location, addressCountry: 'IN' },
  worksFor: { '@type': 'Organization', name: employer.name },
  sameAs: [links.github.href, links.linkedin.href, links.photography.href],
};
---
<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  <Hero />
  <main id="main" tabindex="-1">
    <Work />
    <Experience />
    <Stack />
    <About />
    <Contact />
  </main>
  <Footer />
</Base>
<script>
  import { initReveal } from '../scripts/reveal';
  import { initPaletteLoader } from '../scripts/palette-loader';
  initReveal();
  initPaletteLoader();
</script>
