---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../data/writing';
import { profile } from '../../data/site';
const posts = await getPosts();
---
<Base title={`Writing — ${profile.name}`} description="Notes on building small systems to understand big ones.">
  <header class="site-header page-head">
    <a class="home mono" href="/">← {profile.name}</a>
  </header>
  <main id="main" tabindex="-1">
    <h1 class="page-title">Writing</h1>
    <PostList posts={posts} />
  </main>
  <Footer />
</Base>
<style>
  .page-head { padding-block: 3rem 0; }
  .home { font-size: 0.8125rem; color: var(--muted); text-decoration: none; }
  .page-title { font-size: 1.5rem; margin: 2.5rem 0 2rem; }
  main { padding-bottom: 4rem; }
</style>
